/* C++ ABI (libc++abi / libc++ non-namespaced parts): Itanium ABI shared with the
 * NDK's static libc++abi/libc++. Only compiled into builds with IOSRT_WITH_CXX.
 * The std::__1 template/ABI functions are in the generated cxx_gen.def. */
SYM(libc++, __Znwm, _Znwm)
SYM(libc++, __Znam, _Znam)
SYM(libc++, __ZdlPv, _ZdlPv)
SYM(libc++, __ZdaPv, _ZdaPv)
SYM(libc++, __ZdlPvm, _ZdlPvm)
SYM(libc++, __ZnwmRKSt9nothrow_t, _ZnwmRKSt9nothrow_t)
SYM(libc++, __ZSt7nothrow, _ZSt7nothrow)
SYM(libc++, ___cxa_guard_acquire, __cxa_guard_acquire)
SYM(libc++, ___cxa_guard_release, __cxa_guard_release)
SYM(libc++, ___cxa_guard_abort, __cxa_guard_abort)
SYM(libc++, ___cxa_pure_virtual, __cxa_pure_virtual)
SYM(libc++, ___cxa_deleted_virtual, __cxa_deleted_virtual)
SYM(libc++, ___cxa_bad_cast, __cxa_bad_cast)
SYM(libc++, ___cxa_bad_typeid, __cxa_bad_typeid)
SYM(libc++, ___cxa_demangle, __cxa_demangle)
SYM(libc++, ___cxa_allocate_exception, __cxa_allocate_exception)
SYM(libc++, ___cxa_free_exception, __cxa_free_exception)
SYM(libc++, ___cxa_begin_catch, __cxa_begin_catch)
SYM(libc++, ___cxa_end_catch, __cxa_end_catch)
