/* OpenGLES: EAGL and the GL entry points that need a wrapper (see runtime/src/gl).
 * Every other gl* import binds straight to the device driver (or the null GL)
 * through rt_gl_resolve() in the loader. */
CLASS(OpenGLES, EAGLContext)
CLASS(OpenGLES, EAGLSharegroup)
SYM(OpenGLES, _EAGLGetVersion, iosrt_EAGLGetVersion)
SYM(OpenGLES, _kEAGLDrawablePropertyRetainedBacking, &iosrt_kEAGLDrawablePropertyRetainedBacking)
SYM(OpenGLES, _kEAGLDrawablePropertyColorFormat, &iosrt_kEAGLDrawablePropertyColorFormat)
SYM(OpenGLES, _kEAGLColorFormatRGBA8, &iosrt_kEAGLColorFormatRGBA8)
SYM(OpenGLES, _kEAGLColorFormatRGB565, &iosrt_kEAGLColorFormatRGB565)
SYM(OpenGLES, _kEAGLColorFormatSRGBA8, &iosrt_kEAGLColorFormatSRGBA8)
SYM(OpenGLES, _glGetString, iosrt_glGetString)
SYM(OpenGLES, _glTexImage2D, iosrt_glTexImage2D)
SYM(OpenGLES, _glTexSubImage2D, iosrt_glTexSubImage2D)
SYM(OpenGLES, _glCompressedTexImage2D, iosrt_glCompressedTexImage2D)
SYM(OpenGLES, _glCompressedTexSubImage2D, iosrt_glCompressedTexSubImage2D)
SYM(OpenGLES, _glTexSubImage3D, iosrt_glTexSubImage3D)
SYM(OpenGLES, _glCompressedTexSubImage3D, iosrt_glCompressedTexSubImage3D)
SYM(OpenGLES, _glBlitFramebuffer, iosrt_glBlitFramebuffer)
SYM(OpenGLES, _glIsEnabled, iosrt_glIsEnabled)
SYM(OpenGLES, _glIsBuffer, iosrt_glIsBuffer)
SYM(OpenGLES, _glIsTexture, iosrt_glIsTexture)
SYM(OpenGLES, _glIsFramebuffer, iosrt_glIsFramebuffer)
SYM(OpenGLES, _glIsRenderbuffer, iosrt_glIsRenderbuffer)
SYM(OpenGLES, _glIsFramebufferOES, iosrt_glIsFramebufferOES)
SYM(OpenGLES, _glIsRenderbufferOES, iosrt_glIsRenderbufferOES)
SYM(OpenGLES, _glIsProgram, iosrt_glIsProgram)
SYM(OpenGLES, _glIsShader, iosrt_glIsShader)
SYM(OpenGLES, _glIsVertexArrayOES, iosrt_glIsVertexArrayOES)
SYM(OpenGLES, _glUnmapBufferOES, iosrt_glUnmapBufferOES)
SYM(OpenGLES, _glUnmapBuffer, iosrt_glUnmapBuffer)
SYM(OpenGLES, _glMapBufferOES, iosrt_glMapBufferOES)
SYM(OpenGLES, _glResolveMultisampleFramebufferAPPLE, iosrt_glResolveMultisampleFramebufferAPPLE)
SYM(OpenGLES, _glRenderbufferStorageMultisampleAPPLE, iosrt_glRenderbufferStorageMultisampleAPPLE)
SYM(OpenGLES, _glDiscardFramebufferEXT, iosrt_glDiscardFramebufferEXT)
